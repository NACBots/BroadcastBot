# Fill these in with your own Telegram credentials, then rename this file to .env

# 1) Create a bot with @BotFather -> copy the token here
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 2) Get these from https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# 3) A channel/group id where the bot logs new users (bot must be admin there)
LOG_CHANNEL=-1001234567890

# 4) Space separated Telegram user ids allowed to broadcast (get yours from @userinfobot)
AUTH_USERS=123456789

# 5) MongoDB connection string
#    Local MongoDB started by start-mongo.sh:
DB_URL=mongodb://127.0.0.1:27017
#    Or MongoDB Atlas:
# DB_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=BroadcastBot

# Broadcast tuning
BROADCAST_AS_COPY=True
MAX_CONCURRENT=10
UPDATE_INTERVAL=2
